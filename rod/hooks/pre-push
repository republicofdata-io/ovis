#!/bin/sh
# Refuse a push to the public fork when our new commits hold a private name or a secret.
# Installed by `make hooks` (git config core.hooksPath rod/hooks). See rod/README.md.
set -eu

remote=$1 # git passes the remote name, then its URL
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # a branch deletion: nothing new becomes public
	if [ "$remote_sha" = "$zero" ]; then
		# a new branch: everything not yet on any branch of the fork
		set -- "$local_sha" $(git for-each-ref --format='^%(objectname)' "refs/remotes/$remote/")
	else
		set -- "$local_sha" "^$remote_sha"
	fi
	sh "$(git rev-parse --show-toplevel)/rod/public-check.sh" "$@" </dev/null || status=1
done
exit "$status"
